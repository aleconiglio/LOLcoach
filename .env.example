# Claves de API de League of Legends, Groq y Búsqueda Web
# También se pueden configurar e ingresar directamente desde el panel de Configuración de la App.

VITE_RIOT_API_KEY=RGAPI-xxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VITE_GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Opcional: Proveedor de Búsqueda Web Profunda (Tavily o Serper). Si no se proporciona, utiliza búsqueda web automática DuckDuckGo + Riot Data Dragon
VITE_SEARCH_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

